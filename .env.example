# =====================================================================
# THIS FILE IS A TEMPLATE. Copy to ".env" ONLY for running the seed script on your own computer.
# Never upload .env to GitHub/Netlify drag-and-drop. Server values for the live site go in the
# Netlify dashboard (Site configuration -> Environment variables), not in a file.
# =====================================================================

# --- SERVER-ONLY SECRETS (Netlify dashboard + local .env for seeding) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase -> Project Settings -> API -> service_role / secret key. SECRET!

# --- SERVER-ONLY: Netlify dashboard only (needed for orders + email) ---
RESEND_API_KEY=                       # Resend -> API Keys (sending access). SECRET!
OWNER_EMAIL=                          # where new-order emails are delivered
EMAIL_FROM=Zirwa Orders <orders@yourdomain.com>   # must use a Resend-verified domain
SITE_URL=https://your-site.netlify.app            # no trailing slash; used for the dashboard link in emails
IP_HASH_SALT=                         # any long random text, e.g. 40 random characters

# --- PUBLIC browser values do NOT go here: edit public/js/config.js (URL + anon/publishable key) ---
